{
  "expo": {
    "name": "EaseVerse",
    "slug": "easeverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/web/easeverse_logo_App.png",
    "scheme": "easeverse",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/easeverse_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0F14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.easeverse.app",
      "buildNumber": "45",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow EaseVerse to load photos you choose from your photo library."
      },
      "associatedDomains": [
        "applinks:easeverse.netlify.app"
      ],
      "appleTeamId": "9TAUZCPK95"
    },
    "android": {
      "package": "com.easeverse.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F14",
        "foregroundImage": "./assets/images/web/easeverse_logo_App.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "easeverse.netlify.app",
              "pathPrefix": "/sound-room/invite/"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/easeverse_logo_App_favicon.web.png",
      "backgroundColor": "#0E0F14"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-image",
      "expo-asset",
      "expo-secure-store",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "EaseVerse uses the microphone to turn your voice into lyrics.",
          "speechRecognitionPermission": "EaseVerse uses speech recognition to transcribe your singing and speaking into lyrics."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Velg et profilbilde til samarbeidet i Sound Room.",
          "cameraPermission": false,
          "microphonePermission": "EaseVerse uses your microphone only when you start recording a take."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "2667c360-477b-4c39-9bb6-63195af299b9"
      }
    },
    "owner": "creatorhubn"
  }
}
