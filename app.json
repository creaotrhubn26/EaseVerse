{
  "expo": {
    "name": "EaseVerse",
    "slug": "easeverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/easeverse_logo_App.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/easeverse_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0F14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.easeverse.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.easeverse.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F14",
        "foregroundImage": "./assets/images/easeverse_logo_App.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/easeverse_logo_App_favicon.web.png",
      "backgroundColor": "#0E0F14"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      "expo-image",
      "expo-asset",
      "expo-secure-store",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "EaseVerse uses the microphone to turn your voice into lyrics.",
          "speechRecognitionPermission": "EaseVerse uses speech recognition to transcribe your singing and speaking into lyrics."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "2667c360-477b-4c39-9bb6-63195af299b9"
      }
    },
    "owner": "creatorhubn"
  }
}
