{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.18.0"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "node": "22.18.0"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "credentialsSource": "local",
      "node": "22.18.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://easeverse.netlify.app",
        "EXPO_PUBLIC_DISABLE_LYRICS_SYNC_SOCKET": "1"
      }
    },
    "production-android": {
      "extends": "production",
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "android-preview": {
      "extends": "production-android",
      "autoIncrement": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyId": "9YKHP6L25P",
        "ascApiKeyIssuerId": "c514ca4b-cd18-46a1-bb72-dc1446ed5735",
        "appleTeamId": "9TAUZCPK95",
        "ascApiKeyPath": "./ios-creds/asc-key.p8",
        "ascAppId": "6780806167"
      }
    },
    "production-android": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
